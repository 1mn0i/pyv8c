*.7z filter=lfs diff=lfs merge=lfs -text

# The sources of this binding are stored with LF endings.  Saying so keeps a
# Windows editor -- or a script that writes a file back -- from turning a
# one-line change into a whole-file diff, which is what happened to eight files
# before this rule existed.
*.cpp text eol=lf
*.h text eol=lf
