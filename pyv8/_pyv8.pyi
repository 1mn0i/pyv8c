        receiver_check: int = ...,
        cross_origin_get_check: int = ...,
        cross_origin_set_check: int = ...,
        side_effect: int = ...,
        replaceable: bool = ...,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def getter(self) -> str | Callable[..., Any]: ...
    @property
    def setter(self) -> str | Callable[..., Any] | None: ...
    @property
    def callback_type(self) -> int: ...
    @property
    def location(self) -> int: ...
    @property
    def property_flags(self) -> int: ...
    @property
    def receiver_check(self) -> int: ...
    @property
