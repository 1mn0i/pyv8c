    def replace(self, **changes: Any) -> ConstantCallbackSpec: ...

class Isolate:
    """独立的 V8 Isolate。"""
    def __init__(self) -> None: ...
    def close(self) -> bool: ...
    def context(
        self,
        global_this: Any,
        trace: bool = False,
        ctx_type: Optional[str] = None,
        timeout: Optional[float] = None,
        class_configs: Optional[Dict[type, IdlSpec]] = None,
        lazy_factory: Optional[Callable[[str], Optional[type]]] = None,
        trace_callback: Optional[Callable[..., Any]] = None,
        traceable: bool = False,
        preserve_arguments: bool = False,
    ) -> Context: ...
    def gc(self) -> None: ...
    @property
    def closed(self) -> bool: ...

# 基本类型
class Context:
    """V8 JavaScript执行上下文"""
    def __init__(self, global_this: Any, trace: bool = False, ctx_type: Optional[str] = None, timeout: Optional[float] = None, isolate: Optional[Isolate] = None, class_configs: Optional[Dict[type, IdlSpec]] = None, lazy_factory: Optional[Callable[[str], Optional[type]]] = None, trace_callback: Optional[Callable[..., Any]] = None, traceable: bool = False, preserve_arguments: bool = False) -> None: ...
    def exec_js(self, script: str | Script, filename: Optional[str] = None, timeout: Optional[float] = None) -> Any: ...
    @property
    def isolate_id(self) -> int: ...
    def js_obj(self, py_object: Any) -> Optional[JSObject]: ...
    def expose(self, obj: Any, name: Optional[str] = None) -> Any: ...
    def expose_module(self, module: Any) -> Any: ...
    def declare_lazy(self, names: Sequence[str], skip: Optional[Iterable[str]] = None) -> int: ...
    def gc(self) -> None: ...
    def close(self) -> None: ...
    def update_configs(self, mapping: Mapping[type, IdlSpec]) -> int: ...
    @property
    def glob(self) -> JSObject: ...
    @property
    def trace(self) -> bool: ...
    @trace.setter
    def trace(self, enabled: bool) -> None: ...
    @property
    def timeout(self) -> float: ...
    @timeout.setter
    def timeout(self, value: float) -> None: ...

    # 下面的方法实际上操作的是globalThis对象
    def __getattr__(self, name: str) -> Any: ...
    def __setattr__(self, name: str, value: Any) -> None: ...
    def __getitem__(self, name: str) -> Any: ...
    def __setitem__(self, name: str, value: Any) -> None: ...

class Script:
    """V8 JavaScript脚本"""
    def __init__(self, context: Context, source: str, name: Optional[str] = None) -> None: ...

class Debugger:
    """V8 JavaScript调试器"""
    def __init__(self, context: Context) -> None: ...
    def send(self, message: bytes) -> None: ...
    def schedule_pause_on_next_statement(self, reason: str = ...) -> None: ...
    def cancel_pause_on_next_statement(self) -> None: ...
    def resume(self) -> None: ...
    @property
    def isolate_id(self) -> int: ...
    def disconnect(self) -> None: ...

class JSObject:
    """JavaScript对象的Python封装"""
    def __dir__(self) -> List[str]: ...
    def __getattr__(self, name: str) -> Any: ...
    def __setattr__(self, name: str, value: Any) -> None: ...
    def __getitem__(self, key: Any) -> Any: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...
    def __iter__(self) -> Any: ...
    def __eq__(self, other: JSObject) -> bool: ...
    def __repr__(self) -> str: ...
    def _get(self, name: Any) -> Any: ...
    def _keys(self) -> list[str]: ...
    def _iterator_method(self) -> Any: ...
    def _invoke(self, receiver: Any, *args: Any) -> Any: ...
    def _is_array(self) -> bool: ...
    def _to_python(self) -> Any: ...
    def _to_string(self) -> str: ...
    def _to_number(self) -> float: ...

class JSFunction(JSObject):
    """JavaScript函数的Python封装"""
    def __call__(self, *args: Any, **kwargs: Any) -> Any: ...
    def __repr__(self) -> str: ...

class JSPromise(JSObject):
    """JavaScript Promise的Python封装"""
    def __init__(self, resolve: Optional[Any] = None, reject: Optional[Any] = None) -> None: ...
    def __repr__(self) -> str: ...

class JSTypeArray(JSObject):
    """JavaScript TypedArray的Python封装"""
    def __init__(self, data: List[Union[int, float]], typed: int) -> None: ...
    def __repr__(self) -> str: ...

class JSValue:
    def _to_string(self) -> str: ...
    def _to_number(self) -> float: ...
    def _to_boolean(self) -> bool: ...


class JSException(BaseException):
    """JavaScript异常的Python封装"""
    @property
    def original(self) -> Any: ...

class JavaScriptTerminated(Exception):
    """JavaScript执行终止异常"""
    pass

# 单例对象
Null: JSObject
Undefined: JSObject

# 初始化v8
def init_v8(icudtl_path: Optional[str] = None, params: Optional[List[str]] = None) -> bool: ...

# 永久关闭 V8；仍有活动 Context/JS 对象时会拒绝关闭
def shutdown_v8() -> bool: ...

# 执行isolate->RequestGarbageCollectionForTesting();触发v8垃圾回收
def v8_gc() -> None: ...

# 获取当前v8 Context
def current_context(isolate: Optional[Isolate] = None) -> Optional[Context]: ...

# 获取现任v8 Context
def incumbent_context(isolate: Optional[Isolate] = None) -> Optional[Context]: ...

# 从给定的构造函数创建一个新的JavaScript对象
def new(constructor: Any, *args: Any) -> Any: ...

# v8版本
def v8_version() -> str: ...
