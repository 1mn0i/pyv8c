        value: int = ...,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...
    def replace(self, **changes: Any) -> ConstantSpec: ...

class ConstantCallbackSpec:
    def __init__(self, *,
        name: str,
        callback: str,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
