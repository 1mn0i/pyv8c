# Optional settings; copy values into your shell, replacing the examples.
# PYV8_V8_VERSION=15.4.68
# PYV8_BUILD_ROOT=/path/to/build-cache
# PYV8_DEPOT_TOOLS=/path/to/depot_tools
# PYV8_V8_HOME=/path/to/existing/v8
# PYV8_V8_OUT=/path/to/existing/v8/out
# PYV8_V8_JOBS=4
# PYV8_TARGET_CPU=x64
# PYV8_PROXY=http://127.0.0.1:7890
# PYV8_NO_PROXY=1
# Windows only, if automatic discovery does not work:
# PYV8_VS_HOME=C:\path\to\Visual Studio
# PYV8_WINDOWS_SDK=C:\path\to\Windows Kits\10
